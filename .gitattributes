# Archivos que se ejecutan dentro de contenedores Linux: siempre LF (con core.autocrlf=true en Windows quedaban en CRLF
# y rompían los scripts de init de Postgres, reset-demo.sh y nginx).
*.sh        text eol=lf
*.sql       text eol=lf
*.conf      text eol=lf
*.json      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
